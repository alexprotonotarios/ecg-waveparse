{
  "version": 1,
  "suiteId": "smoke",
  "adapter": "digitizer",
  "candidateId": "selector",
  "description": "Installed-library recovery and review checks. See docs/waveparse/SMOKE-ADJUDICATION.md for the historical policy change and the low-resolution morphology limitation.",
  "global": {
    "maximumFailureCount": 0,
    "maximumFalseDeflectionCount": 0
  },
  "runSafety": {
    "expectedStatus": "needs_review",
    "expectedPublicationOutcome": "needs_review",
    "reviewRequired": true
  },
  "cases": {
    "clean": {
      "requireComplete12Lead": true,
      "maximumGlobalRmseUv": 30,
      "minimumUncertaintyAuroc": 0.8,
      "minimumSafeUsableFraction": 0.65
    },
    "v1_blue_arrow": {
      "requireComplete12Lead": true,
      "maximumGlobalRmseUv": 30,
      "minimumUncertaintyAuroc": 0.8,
      "minimumSafeUsableFraction": 0.65,
      "maximumFalseDeflectionCount": 0
    },
    "v3_notch_resolution": {
      "requireComplete12Lead": true,
      "maximumGlobalRmseUv": 30,
      "minimumUncertaintyAuroc": 0.8,
      "minimumSafeUsableFraction": 0.65,
      "requiredEvents": [
        { "lead": "V3", "id": "v3_r_prime_notch", "requirePreserved": true, "requireTurningPoint": true, "minimumLocalProminenceUv": 80 }
      ]
    },
    "low_resolution": {
      "requireComplete12Lead": true,
      "maximumGlobalRmseUv": 40,
      "minimumUncertaintyAuroc": 0.8,
      "minimumSafeUsableFraction": 0.65,
      "runSafety": {
        "expectedPublicationReasonCode": "reviewable_constrained",
        "maximumEffectiveSampleRateHz": 90
      },
      "requiredEvents": [
        { "lead": "V1", "id": "v1_r_prime", "requirePreserved": true, "requireTurningPoint": true },
        { "lead": "V3", "id": "v3_r_peak", "requirePreserved": true, "requireTurningPoint": true }
      ]
    },
    "blur": {
      "requireComplete12Lead": true,
      "maximumGlobalRmseUv": 45,
      "minimumUncertaintyAuroc": 0.8,
      "minimumSafeUsableFraction": 0.65
    },
    "perspective": {
      "requireComplete12Lead": true,
      "maximumGlobalRmseUv": 40,
      "minimumUncertaintyAuroc": 0.8,
      "minimumSafeUsableFraction": 0.65,
      "runSafety": { "expectedPublicationReasonCode": "reviewable_constrained" },
      "requiredEvents": [
        { "lead": "V1", "id": "v1_r_prime", "requirePreserved": true, "requireTurningPoint": true },
        { "lead": "V3", "id": "v3_r_peak", "requirePreserved": true, "requireTurningPoint": true },
        { "lead": "V3", "id": "v3_r_prime_notch", "requirePreserved": true, "requireTurningPoint": true, "minimumLocalProminenceUv": 80 }
      ]
    }
  }
}
