{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ecg-digitizer.test/schemas/case-manifest.schema.json",
  "title": "ECG digitization benchmark case manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "suiteId", "generator", "cases"],
  "properties": {
    "version": { "const": 1 },
    "suiteId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "suiteSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "suiteSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "clinicalValidation": { "$ref": "#/$defs/clinicalValidation" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "clinicalValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileVersion",
        "studyTier",
        "approvalStatus",
        "intendedPurposeApprovalId",
        "protocolApprovalId",
        "statisticalAnalysisPlanApprovalId",
        "qualityRiskApprovalId",
        "privacyGovernanceApprovalId",
        "regulatoryApprovalId",
        "corpusOwnerApprovalId",
        "independentExecutionPlanId",
        "blindedMappingPlanId"
      ],
      "properties": {
        "profileVersion": { "const": 1 },
        "studyTier": {
          "const": "independent_retrospective_clinical_validation"
        },
        "approvalStatus": { "const": "approved" },
        "intendedPurposeApprovalId": { "type": "string", "minLength": 1 },
        "protocolApprovalId": { "type": "string", "minLength": 1 },
        "statisticalAnalysisPlanApprovalId": {
          "type": "string",
          "minLength": 1
        },
        "qualityRiskApprovalId": { "type": "string", "minLength": 1 },
        "privacyGovernanceApprovalId": {
          "type": "string",
          "minLength": 1
        },
        "regulatoryApprovalId": { "type": "string", "minLength": 1 },
        "corpusOwnerApprovalId": { "type": "string", "minLength": 1 },
        "independentExecutionPlanId": {
          "type": "string",
          "minLength": 1
        },
        "blindedMappingPlanId": { "type": "string", "minLength": 1 }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "sourceId",
        "groupId",
        "split",
        "image",
        "truth",
        "annotations",
        "sampleRateHz",
        "units",
        "layout",
        "paperSpeedMmPerSecond",
        "gainMmPerMv",
        "segmentDurationSeconds",
        "render",
        "degradation",
        "strata",
        "provenance"
      ],
      "properties": {
        "caseId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "sourceId": { "type": "string", "minLength": 1 },
        "groupId": { "type": "string", "minLength": 1 },
        "split": { "enum": ["development", "validation", "heldout", "smoke"] },
        "image": { "$ref": "#/$defs/artifact" },
        "truth": { "$ref": "#/$defs/artifact" },
        "annotations": { "$ref": "#/$defs/artifact" },
        "sampleRateHz": { "type": "number", "exclusiveMinimum": 0 },
        "units": { "const": "uV" },
        "layout": {
          "enum": ["standard_3x4", "standard_6x2", "standard_12x1"]
        },
        "paperSpeedMmPerSecond": { "type": "number", "exclusiveMinimum": 0 },
        "gainMmPerMv": { "type": "number", "exclusiveMinimum": 0 },
        "segmentDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "widthPixels",
            "heightPixels",
            "pixelsPerMm",
            "traceWidthPixels",
            "horizontalPixelsPerSecond",
            "waveformSamplesPerHorizontalPixel",
            "microvoltsPerVerticalPixel"
          ],
          "properties": {
            "widthPixels": { "type": "integer", "minimum": 1 },
            "heightPixels": { "type": "integer", "minimum": 1 },
            "pixelsPerMm": { "type": "number", "exclusiveMinimum": 0 },
            "traceWidthPixels": { "type": "integer", "minimum": 1 },
            "horizontalPixelsPerSecond": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "waveformSamplesPerHorizontalPixel": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "microvoltsPerVerticalPixel": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "degradation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "seed", "parameters"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "seed": { "type": "integer", "minimum": 0 },
            "parameters": { "type": "object" }
          }
        },
        "strata": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "waveformOrigin",
            "quantitativeTruth",
            "clinicalValidationUse",
            "licence"
          ],
          "properties": {
            "waveformOrigin": { "type": "string", "minLength": 1 },
            "quantitativeTruth": { "type": "boolean" },
            "clinicalValidationUse": { "type": "boolean" },
            "licence": { "type": "string", "minLength": 1 },
            "dataset": { "type": "string" },
            "datasetVersion": { "type": "string" },
            "licenceUrl": { "type": "string", "format": "uri" },
            "acquisition": {
              "enum": ["synthetic_render", "scan", "photograph", "digital_export"]
            },
            "imageOrigin": { "type": "string", "minLength": 1 },
            "waveformPairing": { "type": "string", "minLength": 1 },
            "pairingVerificationId": { "type": "string", "minLength": 1 },
            "leadTimeMappingVerificationId": {
              "type": "string",
              "minLength": 1
            },
            "referenceAnnotationProtocolId": {
              "type": "string",
              "minLength": 1
            },
            "provenanceRecordId": { "type": "string", "minLength": 1 },
            "governanceApprovalId": { "type": "string", "minLength": 1 },
            "corpusOwnerApprovalId": { "type": "string", "minLength": 1 },
            "acquisitionDate": { "type": "string", "minLength": 1 },
            "captureDate": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
