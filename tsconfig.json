{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "esnext",
      "dom"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "useDefineForClassFields": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/runtime/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "packages/javascript/dist",
    "packages/javascript/runtime",
    "packages/python/src/ecg_waveparse/runtime"
  ]
}
